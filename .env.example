# Copy this file to .env (repo root) and fill in real values. Never commit .env.
# Do not put real values in this file: it is tracked by git.

# Supabase
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_publishable_key
# Server-side secret (service role) key. Backend only, never ship to the frontend.
SUPABASE_SECRET_KEY=your_supabase_secret_key

# PayPal Sandbox (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_SECRET=your_paypal_sandbox_client_secret
# Optional. Defaults to the sandbox API.
# PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Gemini (optional: without it, explanations use the hand-written fallback text)
GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-3.5-flash-lite

# Server
PORT=5050

# Frontend (goes in frontend/.env, not here)
# VITE_API_URL=http://localhost:5050
